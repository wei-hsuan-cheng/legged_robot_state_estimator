<?xml version="1.0"?>
<package format="3">
  <name>legged_robot_state_estimator</name>
  <version>0.1.0</version>
  <description>Shared contact-aided InEKF and linear KF ros2_control estimators for legged and wheeled-biped robots.</description>
  <maintainer email="johnathancheng0125@gmail.com">Wei-Hsuan Cheng</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>controller_interface</depend>
  <depend>eigen</depend>
  <depend>generate_parameter_library</depend>
  <depend>hardware_interface</depend>
  <depend>legged_state_estimator</depend>
  <depend>nav_msgs</depend>
  <depend>pinocchio</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>tf2_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/legged_robot_state_estimator_plugin.xml"/>
  </export>
</package>
