<?xml version="1.0"?>
<robot name="estimator_test">
  <link name="base">
    <inertial>
      <mass value="5"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  <link name="imu"/>
  <joint name="imu_mount" type="fixed">
    <parent link="base"/><child link="imu"/>
  </joint>
  <link name="left_wheel">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="revolute">
    <parent link="base"/><child link="left_wheel"/>
    <origin xyz="0 0.1 -0.25"/><axis xyz="0 1 0"/>
    <limit lower="-1000" upper="1000" effort="10" velocity="100"/>
  </joint>
  <link name="right_wheel">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="revolute">
    <parent link="base"/><child link="right_wheel"/>
    <origin xyz="0 -0.1 -0.25"/><axis xyz="0 1 0"/>
    <limit lower="-1000" upper="1000" effort="10" velocity="100"/>
  </joint>
  <link name="left_heel"/>
  <joint name="left_heel_mount" type="fixed">
    <parent link="left_wheel"/><child link="left_heel"/><origin xyz="-0.02 0 -0.055"/>
  </joint>
  <link name="left_toe"/>
  <joint name="left_toe_mount" type="fixed">
    <parent link="left_wheel"/><child link="left_toe"/><origin xyz="0.02 0 -0.055"/>
  </joint>
  <link name="right_heel"/>
  <joint name="right_heel_mount" type="fixed">
    <parent link="right_wheel"/><child link="right_heel"/><origin xyz="-0.02 0 -0.055"/>
  </joint>
  <link name="right_toe"/>
  <joint name="right_toe_mount" type="fixed">
    <parent link="right_wheel"/><child link="right_toe"/><origin xyz="0.02 0 -0.055"/>
  </joint>
</robot>
